PORT=3000
PRINTER_NAME=LX310

# Cabang Toko: 'ketapang' atau 'pontianak' (menentukan tampilan & header nota)
BRANCH=ketapang

# URL Web Server POS untuk toko ini (HTTPS domain)
# Contoh Toko Ketapang: https://pos.yourdomain.com/ketapang
# Contoh Toko Pontianak: https://pos.yourdomain.com/pontianak
SERVER_API_URL=https://pos.yourdomain.com/ketapang
