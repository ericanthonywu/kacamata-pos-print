PORT=3000
# PRINTER_NAME: Nama share printer nota di Windows
# Ketapang: LX310 (Epson LX-310 Dot Matrix, 80 kolom)
# Pontianak: XH-80UL (Iware XH-80UL Thermal 80mm, 48 kolom)
PRINTER_NAME=LX310
BARCODE_PRINTER_NAME=BARCODE

# Cabang Toko: 'ketapang' (dot-matrix 80 kolom) atau 'pontianak' (thermal 80mm / 48 kolom)
BRANCH=ketapang

# URL Web Server POS untuk toko ini (HTTPS domain)
# Contoh Toko Ketapang: https://pos.yourdomain.com/ketapang
# Contoh Toko Pontianak: https://pos.yourdomain.com/pontianak
SERVER_API_URL=https://pos.yourdomain.com/ketapang
